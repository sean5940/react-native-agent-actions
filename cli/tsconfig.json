{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["*.mjs", "generators/*.mjs", "integrate/*.mjs"]
}
